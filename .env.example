# ClientTurn — environment reference
#
# Every variable the code actually reads, and nothing it does not. Copy the
# ones you need into `.env` (provider credentials) and `.env.local`
# (deployment configuration); both are gitignored.
#
# REQUIRED means the app throws on boot without it — see src/lib/env.ts.
# Everything else degrades: a missing integration reports itself as
# unavailable rather than breaking a page.

# =====================================================================
# Supabase
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=                 # REQUIRED
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # REQUIRED — browser client
SUPABASE_SERVICE_ROLE_KEY=                # REQUIRED — server only, never NEXT_PUBLIC
SUPABASE_PAT=                             # personal access token, tooling only
SUPABASE_PROJECT_REF=                     # e.g. losieaikadkadtmezini

# =====================================================================
# Stripe
# =====================================================================
# The app reads ONLY the test key: `secretKey: required("STRIPE_SECRET_KEY_TEST")`.
# Going live means swapping this to the live key AND the snapshot webhook
# secret to the live endpoint's, together — one without the other means every
# delivery fails signature verification silently.
STRIPE_SECRET_KEY_TEST=                   # REQUIRED
STRIPE_SECRET_KEY_LIVE=                   # not read by the app; ops only

# Webhook signing. Both destinations post to /api/webhooks/stripe and the
# route verifies against whichever secret matches.
STRIPE_WEBHOOK_SECRET_SNAPSHOT=           # v1 events — the ones the app acts on
STRIPE_WEBHOOK_SECRET_THIN=               # v2 `v2.core.*`; unused today
STRIPE_WEBHOOK_SECRET_CLIENTTURN=         # pre-split secret, still accepted
STRIPE_WEBHOOK_SECRET_LOCAL=              # local only — see scripts/stripe-local-event.mjs
STRIPE_WEBHOOK_DESTINATION_ID_SNAPSHOT=
STRIPE_WEBHOOK_DESTINATION_ID_THIN=
# Stripe Tax (VAT). Off by default. Set to true ONLY after registering for VAT
# and adding the registration in Stripe Tax: it turns on automatic_tax, VAT
# number and billing-address collection on every Checkout, and switches the
# pricing copy to "VAT is added at checkout" (src/lib/billing/tax.ts).
STRIPE_AUTOMATIC_TAX=false

# Plan prices. Must exist in the same Stripe account as the secret key above.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Voice (OD-2). TEST-mode prices the owner creates by hand in the Stripe
# dashboard; nothing in the codebase creates Stripe objects. Each is optional:
# when one is missing the matching purchase is refused with a "not set up yet"
# message instead of failing. Amounts must match lib/billing/plans.ts.
STRIPE_PRICE_VOICE_ADDON_MONTHLY=         # £100/month recurring, Pro voice item (no annual price)
STRIPE_PRICE_VOICE_NUMBER_MONTHLY=        # £11.99/month recurring, dedicated number
STRIPE_PRICE_VOICE_PACK_100=              # £49 one-off, 100 minutes
STRIPE_PRICE_VOICE_PACK_250=              # £115 one-off, 250 minutes
STRIPE_PRICE_VOICE_PACK_500=              # £225 one-off, 500 minutes
STRIPE_PRICE_VOICE_PACK_1000=             # £449 one-off, 1000 minutes

# =====================================================================
# Site and background processing
# =====================================================================
# Used for OAuth redirects, checkout return URLs and the cron dispatcher.
# Must be the real origin in production — a stale localhost value breaks
# every redirect back into the app.
NEXT_PUBLIC_SITE_URL=https://clientturn.com

# Must match `clientturn_cron_secret` in Supabase Vault, or the scheduled
# worker gets a 401 and the queue stops draining. See docs/CRON.md.
CRON_SECRET=
# Day-90 deletion of cancelled workspaces (billing/workspace-deletion.ts, 0170).
# Unset = the daily job only reports its plan (dry run): no notice, no deletion.
# Set to true only after 0170 is applied and a dry-run report has been checked.
WORKSPACE_DELETION_ENABLED=

# =====================================================================
# Error tracking and ops alerts (docs/OBSERVABILITY.md)
# =====================================================================
# Sentry. Leave SENTRY_DSN empty and the SDK is never loaded: no cost, no
# events, no build plugin (dev and tests). The DSN is public by design;
# next.config.ts copies it to NEXT_PUBLIC_SENTRY_DSN for the browser.
SENTRY_DSN=
SENTRY_ENVIRONMENT=                      # defaults to VERCEL_ENV / NODE_ENV
SENTRY_TRACES_SAMPLE_RATE=               # 0..1; empty = tracing off
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=   # browser tracing; empty = off
# Source-map upload at build time (server-only; a CI/Vercel secret).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Push alerts: dead jobs, webhook failure spikes, cron misses, queue
# backlog, provider outages, margin alerts. Each kind at most once an hour.
OPS_ALERT_EMAIL=                         # comma-separated; sent via Resend
OPS_ALERT_WEBHOOK_URL=                   # optional Slack incoming webhook (https)

# =====================================================================
# App signing secrets
# =====================================================================
# Both fall back to SUPABASE_SERVICE_ROLE_KEY if unset, which works but means
# one compromise spans the database and the signing key. Give them their own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_STEP_UP_SECRET=
AFFILIATE_COOKIE_SECRET=
# Signs the workspace idle-timeout activity cookie (Settings -> Security).
# Optional: falls back to ADMIN_STEP_UP_SECRET. With neither set in
# production, the idle timeout is not enforced (docs/security/MFA_AND_SESSIONS.md).
SESSION_ACTIVITY_SECRET=

# Encrypts customer mailbox passwords at rest. Without it, email account
# setup reports itself unavailable rather than storing a password in clear.
CREDENTIAL_ENCRYPTION_KEY=

# =====================================================================
# Azure OpenAI (EU) — the AI layer
# =====================================================================
# All four are needed together; `isAzureConfigured()` is false otherwise and
# every AI task falls back to its deterministic path.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_DEFAULT=         # the "mini" tier
AZURE_OPENAI_DEPLOYMENT_FAST=            # the "nano" tier

# =====================================================================
# Twilio — SMS and WhatsApp
# =====================================================================
# TWILIO_ACCOUNT_SID must be the ACCOUNT SID and start with `AC`. It is
# interpolated into /Accounts/{sid}/Messages.json, so an API-key SID (`SK`)
# there fails every send. If you authenticate with an API key, the SK/secret
# pair is the auth, and the AC sid is still what belongs in the path.
TWILIO_ACCOUNT_SID=                      # AC…
TWILIO_AUTH_TOKEN=
TWILIO_SID=                              # legacy alias for ACCOUNT_SID
TWILIO_CLIENT_SECRET=                    # legacy alias for AUTH_TOKEN
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_URL=                      # public URL Twilio posts to; signature check

# ----- Voice sales agent (phase P2, docs/VOICE.md) -----
# All optional. Absent = voice shows "integration required" and never dials.
# The Twilio voice/number side reuses TWILIO_ACCOUNT_SID (AC...) and
# TWILIO_AUTH_TOKEN above (parent account; one subaccount per workspace).
RETELL_SECRET_KEY=                       # server-only secret key; also verifies X-Retell-Signature. (RETELL_API_KEY accepted as an alias.)
# RETELL_PUBLIC_KEY is for browser web calls only; the server never reads it.
RETELL_AGENT_ID=                         # the platform default Retell agent (a workspace may override)
RETELL_LLM_ID=                           # voice P3: the Retell LLM scripts/retell-setup.mjs created (printed by the script)
RETELL_VOICE_ID=                         # voice P3: setup script; the platform default voice (provisional cartesia-Willa; never an 11labs premium voice)
RETELL_VOICE_SPEED=                      # voice P3: setup script; default 1.0 (voice-profile.ts DEFAULT_VOICE_FEEL)
RETELL_RESPONSIVENESS=                   # voice P3: setup script; default 0.9
RETELL_INTERRUPTION_SENSITIVITY=         # voice P3: setup script; default 0.8
RETELL_BACKCHANNEL=                      # voice P3: setup script; 1 (default) or 0
RETELL_AMBIENT_SOUND=                    # voice P3: setup script; none (default) or a Retell ambient sound
RETELL_LLM_MODEL=                        # voice P3: setup script only; default gpt-4.1-mini (the stack A cost, docs/economics.md §13)
VOICE_WEBHOOK_BASE_URL=                  # public https origin Retell/Twilio call back to (defaults to NEXT_PUBLIC_SITE_URL)
VOICE_CALLS_DISABLED=                    # "1" = platform kill switch: no AI call on any workspace
VOICE_BUNDLE_NOTIFICATION_EMAIL=         # where Twilio emails regulatory bundle status (ops mailbox)
RETELL_SIP_DOMAIN=                       # inbound return calls: Twilio <Dial><Sip> to this Retell SIP domain (UNVERIFIED; absent = no AI on inbound)

# =====================================================================
# Email
# =====================================================================
RESEND_API_KEY=
RESEND_FROM=Client Turn <notifications@clientturn.com>

# =====================================================================
# Cloudflare R2 — logos and CSV imports
# =====================================================================
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clientturn

# =====================================================================
# OAuth providers — each optional; absent means "not offerable"
# =====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Typed into Meta's dashboard by hand and echoed back during the webhook
# subscription handshake. Separate from META_APP_SECRET, which signs every
# delivery: this one authenticates the handshake only. Without it
# /api/webhooks/meta refuses to verify — which means no inbound Messenger or
# Instagram messages, and lead forms fall back to the poll interval.
META_WEBHOOK_VERIFY_TOKEN=
# The WhatsApp Embedded Signup configuration id, from the WhatsApp use case on
# the app. Each customer connects their own WhatsApp Business Account and phone
# number through this dialog; without it the connect flow grants scopes and
# creates no account, so the provider is hidden rather than offered broken.
META_WHATSAPP_CONFIG_ID=
CALENDLY_API_KEY=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Optional. Zoho's Multi DC support keeps one client_id across every DC
# (US, EU, UK, AU, IN, JP, CN, CA, SA, UAE, Singapore). If the API Console
# client has "use the same OAuth credentials for all data centers" enabled,
# ZOHO_CLIENT_SECRET above is all that's needed — every DC uses it. Only set
# the vars below if that client instead issues a distinct secret per DC; any
# DC without one of these still falls back to the base secret above.
ZOHO_CLIENT_SECRET_EU=
ZOHO_CLIENT_SECRET_IN=
ZOHO_CLIENT_SECRET_AU=
ZOHO_CLIENT_SECRET_JP=
ZOHO_CLIENT_SECRET_CN=
ZOHO_CLIENT_SECRET_CA=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# HubSpot uses a customer-pasted private-app token, so there is nothing
# platform-level to configure.

# =====================================================================
# Sourcing and enrichment (V4)
# =====================================================================
# Paid enrichment vendors are OFF (CLAUDE.md resolved conflict 7). The three
# keys below are ignored unless ENABLE_PAID_ENRICHMENT=true, and turning that
# on needs the privacy policy and sub-processor list changed first.
ENABLE_PAID_ENRICHMENT=false
APOLLO_API_KEY=
CLEARBIT_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
SOURCING_PROVIDER_TIMEOUT_MS=

# =====================================================================
# Maintenance break-glass (docs/MAINTENANCE.md)
# Normally unset: maintenance is switched in /admin/site. Set these only when
# the database itself is down and the admin switch cannot be reached.
# =====================================================================
MAINTENANCE_OVERRIDE_LEVEL=              # READ_ONLY | APP_OFFLINE | SITE_OFFLINE
MAINTENANCE_OVERRIDE_MESSAGE=
MAINTENANCE_OVERRIDE_UNTIL=              # ISO time shown as "expected back"
MAINTENANCE_OVERRIDE_KEEP_AUTOMATION=    # "1" keeps outbound sends running

# =====================================================================
# Development only
# =====================================================================
MESSAGING_PROVIDER=                      # "stub" to send nothing for real
QA_ORIGIN=
