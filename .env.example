# ClientTurn — environment reference
#
# Every variable the code actually reads, and nothing it does not. Copy the
# ones you need into `.env` (provider credentials) and `.env.local`
# (deployment configuration); both are gitignored.
#
# REQUIRED means the app throws on boot without it — see src/lib/env.ts.
# Everything else degrades: a missing integration reports itself as
# unavailable rather than breaking a page.

# =====================================================================
# Supabase
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=                 # REQUIRED
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # REQUIRED — browser client
SUPABASE_SERVICE_ROLE_KEY=                # REQUIRED — server only, never NEXT_PUBLIC
SUPABASE_PAT=                             # personal access token, tooling only
SUPABASE_PROJECT_REF=                     # e.g. losieaikadkadtmezini

# =====================================================================
# Stripe
# =====================================================================
# The app reads ONLY the test key: `secretKey: required("STRIPE_SECRET_KEY_TEST")`.
# Going live means swapping this to the live key AND the snapshot webhook
# secret to the live endpoint's, together — one without the other means every
# delivery fails signature verification silently.
STRIPE_SECRET_KEY_TEST=                   # REQUIRED
STRIPE_SECRET_KEY_LIVE=                   # not read by the app; ops only

# Webhook signing. Both destinations post to /api/webhooks/stripe and the
# route verifies against whichever secret matches.
STRIPE_WEBHOOK_SECRET_SNAPSHOT=           # v1 events — the ones the app acts on
STRIPE_WEBHOOK_SECRET_THIN=               # v2 `v2.core.*`; unused today
STRIPE_WEBHOOK_SECRET_CLIENTTURN=         # pre-split secret, still accepted
STRIPE_WEBHOOK_SECRET_LOCAL=              # local only — see scripts/stripe-local-event.mjs
STRIPE_WEBHOOK_DESTINATION_ID_SNAPSHOT=
STRIPE_WEBHOOK_DESTINATION_ID_THIN=

# Plan prices. Must exist in the same Stripe account as the secret key above.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# =====================================================================
# Site and background processing
# =====================================================================
# Used for OAuth redirects, checkout return URLs and the cron dispatcher.
# Must be the real origin in production — a stale localhost value breaks
# every redirect back into the app.
NEXT_PUBLIC_SITE_URL=https://clientturn.com

# Must match `clientturn_cron_secret` in Supabase Vault, or the scheduled
# worker gets a 401 and the queue stops draining. See docs/CRON.md.
CRON_SECRET=

# =====================================================================
# App signing secrets
# =====================================================================
# Both fall back to SUPABASE_SERVICE_ROLE_KEY if unset, which works but means
# one compromise spans the database and the signing key. Give them their own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_STEP_UP_SECRET=
AFFILIATE_COOKIE_SECRET=

# Encrypts customer mailbox passwords at rest. Without it, email account
# setup reports itself unavailable rather than storing a password in clear.
CREDENTIAL_ENCRYPTION_KEY=

# =====================================================================
# Azure OpenAI (EU) — the AI layer
# =====================================================================
# All four are needed together; `isAzureConfigured()` is false otherwise and
# every AI task falls back to its deterministic path.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_DEFAULT=         # the "mini" tier
AZURE_OPENAI_DEPLOYMENT_FAST=            # the "nano" tier

# =====================================================================
# Twilio — SMS and WhatsApp
# =====================================================================
# TWILIO_ACCOUNT_SID must be the ACCOUNT SID and start with `AC`. It is
# interpolated into /Accounts/{sid}/Messages.json, so an API-key SID (`SK`)
# there fails every send. If you authenticate with an API key, the SK/secret
# pair is the auth, and the AC sid is still what belongs in the path.
TWILIO_ACCOUNT_SID=                      # AC…
TWILIO_AUTH_TOKEN=
TWILIO_SID=                              # legacy alias for ACCOUNT_SID
TWILIO_CLIENT_SECRET=                    # legacy alias for AUTH_TOKEN
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_URL=                      # public URL Twilio posts to; signature check

# =====================================================================
# Email
# =====================================================================
RESEND_API_KEY=
RESEND_FROM=Client Turn <notifications@clientturn.com>

# =====================================================================
# Cloudflare R2 — logos and CSV imports
# =====================================================================
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clientturn

# =====================================================================
# OAuth providers — each optional; absent means "not offerable"
# =====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
CALENDLY_API_KEY=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=
# HubSpot uses a customer-pasted private-app token, so there is nothing
# platform-level to configure.

# =====================================================================
# Sourcing and enrichment (V4)
# =====================================================================
APOLLO_API_KEY=
CLEARBIT_API_KEY=
HUNTER_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
SOURCING_PROVIDER_TIMEOUT_MS=

# =====================================================================
# Development only
# =====================================================================
MESSAGING_PROVIDER=                      # "stub" to send nothing for real
QA_ORIGIN=
